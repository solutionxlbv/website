/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Astro build output (CSS, fonts): file names contain a content hash,
# so these can be cached for a year without going stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The CV is replaced under the same file name: always revalidate,
# so recruiters never get an outdated version from their browser cache.
/assets/*.pdf
  Cache-Control: public, max-age=0, must-revalidate

# Fixed-name files: cache for a day, then revalidate.
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.jpg
  Cache-Control: public, max-age=86400
